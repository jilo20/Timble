# Copy to .env; never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set MYSQL_DATABASE to select MySQL. Omit DB variables for local SQLite.
# MYSQL_DATABASE=timble
# MYSQL_USER=your-user
# MYSQL_PASSWORD=your-password
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# SQLITE_PATH overrides MySQL/PostgreSQL; tests use an isolated SQLite database.
